{
  "name": "fossil-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Fossil compiler + LSP + playground React library family — monorepo root",
  "scripts": {
    "build": "pnpm -r build",
    "build:wasm": "pnpm --filter @fossil-lang/wasm build:wasm",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "size": "pnpm -r size",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "size-limit": "^11.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
