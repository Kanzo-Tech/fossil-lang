{
  "name": "fossil-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Fossil compiler + LSP + editor React library family — monorepo root",
  "//scripts": "The four recursive scripts stay on packages/ — an app is not a library and has neither a size budget nor a dist to build for anyone. `docs:*` is the separate door.",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "build:wasm": "pnpm --filter @fossil-lang/wasm build:wasm",
    "test": "pnpm --filter \"./packages/*\" test",
    "lint": "pnpm --filter \"./packages/*\" lint",
    "size": "pnpm --filter \"./packages/*\" size",
    "docs:dev": "pnpm --filter @fossil-lang/docs dev",
    "docs:build": "pnpm --filter @fossil-lang/docs build"
  },
  "devDependencies": {
    "size-limit": "^11.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
