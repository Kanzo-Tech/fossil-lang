PREFIX ex:   <https://example.org/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# Minimal ShEx shape for the hello.fossil walking skeleton (Phase 1).
# Mirrors the Mapping `User : ex:Person from users` with one property
# `ex:name`. Phase 7 plan 07-04 uses this as the default ShEx panel
# content; plan 07-05 wires Monaco to view it.

ex:User {
    ex:name xsd:string
}
