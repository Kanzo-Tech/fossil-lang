// canonical_200.fossil — the LSP performance fixture (the didChange round-trip
// budget) AND the input of the end-to-end feature test.
//
// IT IS NOT A CONFORMANCE PROGRAM. The conformance set is `apps/docs/programs/`
// and grammar.bnf names it; this is a BENCH. 8 sources and 15 mappings, and the
// size is the whole point: `crates/fossil-lsp/tests/didchange_budget.rs` is a
// hard CI gate at 400 ms, and a budget measured over a twelve-line file asserts
// nothing. The largest conformance program has ~30 lines.
//
// It also deliberately spells three corners no conformance program exercises:
// `str.trim` / `lower` / `upper` / `slug` (the five that used to be `clean.*`
// before ruling 16 folded that namespace into `str`), `math.round`, and
// `str.concat` with two arguments.
//
// The second file is `canonical_200.shex`, and what crosses between them is a
// LANGUAGE boundary: every shape name in a header below and every property key
// is defined in that document, not here (ruling 12). `crates/fossil-ide`'s
// goto-def is what walks it.
//
// Comment lines use `//` (the Fossil comment syntax). A bare `#` is unlexable
// and would hang the parser — it MUST NOT appear.

// ─── The output contract ─────────────────────────────────────────────────────
//
// Fifteen names, bound POSITIONALLY to the fifteen shapes the document declares
// in its own order. One shape per mapping.

type { Person, Organization, Product, Order, Review, Membership, PostalAddress, Category, ProductCategory, Profile, OrderLine, Contact, PriceSnapshot, ReviewSummary, GeoAddress } := io.shex("canonical_200.shex")

// ─── Source bindings ─────────────────────────────────────────────────────────

Users := io.csv("users.csv")

Orders := io.csv("orders.csv")

Products := io.csv("products.csv")

Orgs := io.csv("organizations.csv")

Memberships := io.csv("memberships.csv")

Reviews := io.csv("reviews.csv")

Addresses := io.csv("addresses.csv")

Categories := io.csv("categories.csv")

// ─── Mapping 1: people ───────────────────────────────────────────────────────

People : Person from Users
    @subject = "https://example.org/person/{Users.id}"
    name = str.trim(Users.name)
    nick = str.lower(Users.nick)
    email = Users.email
    age = Users.age
    active = Users.active

// ─── Mapping 2: organizations ────────────────────────────────────────────────

Companies : Organization from Orgs
    @subject = "https://example.org/org/{Orgs.org_id}"
    name = str.upper(Orgs.org_name)
    legalName = Orgs.legal_name
    country = Orgs.country
    founded = Orgs.founded_year

// ─── Mapping 3: products ─────────────────────────────────────────────────────

Catalogue : Product from Products
    @subject = "https://example.org/product/{Products.sku}"
    name = Products.product_name
    price = math.round(Products.price)
    currency = Products.currency
    inStock = Products.in_stock
    slug = str.slug(Products.product_name)

// ─── Mapping 4: orders ───────────────────────────────────────────────────────

Purchases : Order from Orders
    @subject = "https://example.org/order/{Orders.order_id}"
    placedBy = "https://example.org/person/{Orders.user_id}"
    total = math.round(Orders.amount)
    quantity = Orders.quantity
    orderedAt = Orders.created_at

// ─── Mapping 5: reviews ──────────────────────────────────────────────────────

Ratings : Review from Reviews
    @subject = "https://example.org/review/{Reviews.review_id}"
    author = "https://example.org/person/{Reviews.author_id}"
    itemReviewed = "https://example.org/product/{Reviews.sku}"
    reviewBody = str.trim(Reviews.body)
    ratingValue = Reviews.rating

// ─── Mapping 6: memberships (person ↔ org) ───────────────────────────────────

Members : Membership from Memberships
    @subject = "https://example.org/membership/{Memberships.membership_id}"
    member = "https://example.org/person/{Memberships.user_id}"
    organization = "https://example.org/org/{Memberships.org_id}"
    role = str.upper(Memberships.role)
    since = Memberships.joined_at

// ─── Mapping 7: addresses ────────────────────────────────────────────────────

Places : PostalAddress from Addresses
    @subject = "https://example.org/address/{Addresses.address_id}"
    streetAddress = str.trim(Addresses.street)
    addressLocality = Addresses.city
    postalCode = Addresses.zip
    addressCountry = str.upper(Addresses.country_code)

// ─── Mapping 8: categories ───────────────────────────────────────────────────

Sections : Category from Categories
    @subject = "https://example.org/category/{Categories.category_id}"
    name = Categories.category_name
    slug = str.slug(Categories.category_name)
    parent = Categories.parent_id

// ─── Mapping 9: product → category link ──────────────────────────────────────

Shelving : ProductCategory from Products
    @subject = "https://example.org/product/{Products.sku}/category"
    belongsTo = "https://example.org/category/{Products.category_id}"
    displayName = str.concat(Products.product_name, Products.currency)

// ─── Mapping 10: enriched person profile ─────────────────────────────────────

Profiles : Profile from Users
    @subject = "https://example.org/profile/{Users.id}"
    name = str.trim(Users.name)
    mbox = Users.email
    displayLabel = str.concat(Users.name, Users.nick)
    ageGroup = Users.age
    homepage = "https://example.org/person/{Users.id}/home"

// ─── Mapping 11: order line items ────────────────────────────────────────────

Lines : OrderLine from Orders
    @subject = "https://example.org/orderline/{Orders.order_id}/{Orders.user_id}"
    lineOrder = "https://example.org/order/{Orders.order_id}"
    lineProduct = "https://example.org/product/{Orders.sku}"
    quantity = Orders.quantity
    price = math.round(Orders.amount)

// ─── Mapping 12: organization contacts ───────────────────────────────────────

Contacts : Contact from Orgs
    @subject = "https://example.org/org/{Orgs.org_id}/contact"
    contactOf = "https://example.org/org/{Orgs.org_id}"
    name = str.trim(Orgs.contact_name)
    email = str.lower(Orgs.contact_email)
    telephone = Orgs.phone

// ─── Mapping 13: product pricing snapshot ────────────────────────────────────

Prices : PriceSnapshot from Products
    @subject = "https://example.org/product/{Products.sku}/price"
    snapshotOf = "https://example.org/product/{Products.sku}"
    price = math.round(Products.price)
    priceCurrency = str.upper(Products.currency)
    capturedAt = Products.updated_at

// ─── Mapping 14: review summary per product ──────────────────────────────────

Summaries : ReviewSummary from Reviews
    @subject = "https://example.org/review/{Reviews.review_id}/summary"
    summaryOf = "https://example.org/product/{Reviews.sku}"
    reviewer = "https://example.org/person/{Reviews.author_id}"
    reviewRating = Reviews.rating
    headline = str.trim(Reviews.body)

// ─── Mapping 15: address geocoding stub ──────────────────────────────────────

Geo : GeoAddress from Addresses
    @subject = "https://example.org/geo/{Addresses.address_id}"
    locationOf = "https://example.org/address/{Addresses.address_id}"
    addressLocality = str.upper(Addresses.city)
    postalCode = Addresses.zip
    countryCode = str.upper(Addresses.country_code)
