(* ═══════════════════════════════════════════════════════════════ *)
(*  FOSSIL — Grammar (EBNF) — v0.1                                   *)
(*                                                                    *)
(*  This is the formal grammar of the Fossil language.               *)
(*  See: type-system.md (semantic rules), architecture.md (compiler) *)
(* ═══════════════════════════════════════════════════════════════ *)


(* ═══ LEXICAL LAYER ═══ *)
(* Tokens produced by the lexer. Whitespace is significant            *)
(* (indentation tokens INDENT/DEDENT). Comments are discarded.        *)

LETTER         := [a-zA-Z]
DIGIT          := [0-9]
SPACE          := ' '
TAB            := '\t'
WHITESPACE     := SPACE | TAB
NEWLINE        := '\n'

(* INDENT and DEDENT are virtual tokens emitted by the lexer        *)
(* based on column tracking. Spaces or tabs but consistent per block. *)
INDENT, DEDENT := computed

(* Identifiers and keywords *)
IDENT          := (LETTER | '_') (LETTER | DIGIT | '_')*
KEYWORD        := 'prefix' | 'in' | 'from' | 'use' | 'as'
                | 'and' | 'or' | 'not' | 'iri'

(* Numeric literals — decimal only, optional underscores as separators *)
INTEGER        := DIGIT (DIGIT | '_')*
FLOAT          := INTEGER '.' INTEGER

(* String literals. Interpolation is ALWAYS ACTIVE and `{{` is the escape for a
   literal '{' (ADR-0057, seventh amendment §3). A closing '}' needs no escape:
   outside a hole it has only one reading.

   A string with no hole is one STRING token. One WITH a hole is carved by the
   post-lexer pass into the run below, so the hole's expression is read by the
   ordinary expression parser — the interpolation is IN THIS GRAMMAR, not in the
   lexer, which is the lesson PEP 701 paid seven years for. *)
STRING         := '"' STRING_CONTENT* '"'
STRING_CONTENT := REGULAR_CHAR | ESCAPE | '{{'
ESCAPE         := '\n' | '\t' | '\r' | '\\' | '\"'

STRING_OPEN    := '"' | '`'
STRING_TEXT    := (REGULAR_CHAR | ESCAPE | '{{')*
INTERP_OPEN    := '{' | '${'                (* '${' dies with TEMPLATE *)
STRING_CLOSE   := '"' | '`'

(* Template literals — RETIRED by ADR-0057's seventh amendment; the spelling
   survives only until the fixtures are rewritten. *)
TEMPLATE       := '`' TPL_CONTENT* '`'
TPL_CONTENT    := REGULAR_CHAR | TPL_ESCAPE | Interpolation
TPL_ESCAPE     := ESCAPE | '\`' | '\$' | '\${'

(* IRI literals *)
ABS_IRI        := '<' IRI_CHARS '>'           (* RFC 3986 chars *)

(* Environment variable reference *)
ENV_VAR        := '$' IDENT

(* Comments — discarded by lexer *)
COMMENT        := '//' (any char except NEWLINE)*

(* Operators *)
DEFINE         := ':='
ASSIGN         := '='
SHAPE_SEP      := ':'
SHAPE_AND      := '&'
PIPE           := '|>'
T_QUESTION     := '?'
T_COLON        := ':'                          (* contextual with T_QUESTION *)
TRIPLE_OPEN    := '<<'
TRIPLE_CLOSE   := '>>'

EQ             := '=='
NEQ            := '!='
LT             := '<'
LE             := '<='
GT             := '>'
GE             := '>='

PLUS           := '+'
MINUS          := '-'
STAR           := '*'
SLASH          := '/'
PERCENT        := '%'

DOT            := '.'
COMMA          := ','
LPAREN, RPAREN := '(' ')'
LBRACE, RBRACE := '{' '}'

(* Attributes — lexed but consumed by no production yet. The spelling is NOT
   open: it is `@`, decided in ADR-0057's fourth amendment for the reasons
   restated under RESERVED KEYWORDS below. What a production will accept is
   bounded by the seventh amendment: an attribute takes constants only, so a
   form that dereferences the row is syntax wearing the sigil, not an
   attribute. *)
AT_ATTR        := '@' IDENT


(* ═══ GRAMMAR ═══ *)

(* ─── Top level ─── *)

Program             := TopLevel* EOF

TopLevel            := Import
                     | PrefixDecl
                     | SourceDef
                     | MultiSourceDef
                     | TypeDef
                     | Mapping


(* ─── Imports ─── *)

Import              := 'use' Path SelectiveImport? Alias?

Path                := PathSegment ('/' PathSegment)*
PathSegment         := IDENT | STRING

SelectiveImport     := LBRACE IDENT (COMMA IDENT)* RBRACE

Alias               := 'as' IDENT


(* ─── Vocabulary and bindings ─── *)

PrefixDecl          := 'prefix' IDENT SHAPE_SEP ABS_IRI

SourceDef           := IDENT DEFINE Expression

(* Destructuring source: one binding per shape declared by the source schema. *)
MultiSourceDef      := LBRACE IDENT (COMMA IDENT)* RBRACE DEFINE Expression

(* Type binding: the same destructuring, in type position. One catalogue
   (`io.*`), two binders — `:=` for values, `type … =` for types (ADR-0057,
   seventh amendment). Binding is POSITIONAL: the Nth name binds the Nth shape
   the document declares, and the name is a free local label (tenth amendment).
   `type` is NOT a reserved word: at top level `IDENT LBRACE` is free, and the
   next token separates this from `SourceDef` (`:=`) and from a mapping header
   (`:`). That matters — `type` is a plausible column name in a language whose
   commonest predicate is `rdf:type`. *)
TypeDef             := 'type' LBRACE IDENT (COMMA IDENT)* RBRACE ASSIGN Expression


(* ─── Mappings ─── *)

Mapping             := MappingHeader NEWLINE INDENT MappingBody DEDENT

MappingHeader       := IDENT SHAPE_SEP ShapeExpr InClause? 'from' Expression

ShapeExpr           := IRIExpr (SHAPE_AND IRIExpr)*    (* intersection *)

InClause            := 'in' IRIExpr

MappingBody         := SubjectAttr? Property+

(* The subject, as the FIRST line of the body — not above the header, because
   the row binder is introduced BY the header and above it does not exist yet
   (ADR-0057, seventh amendment §4). It is syntax with a sigil, not an
   attribute: it is required in every mapping, and it dereferences the row,
   which an attribute may never do.

   This is the first production to accept `@`. *)
SubjectAttr         := AT_ATTR LPAREN 'iri' ASSIGN Expression RPAREN
                       (* AT_ATTR is `@subject`; any other name is an error *)

Property            := PropertyLhs ASSIGN Expression AnnotationBlock?

PropertyLhs         := 'iri'                     (* retired by SubjectAttr *)
                     | IRIExpr

AnnotationBlock     := LBRACE AnnotationBody RBRACE

AnnotationBody      := AnnotationList                              (* single-line *)
                     | NEWLINE INDENT (AnnotationItem NEWLINE)+ DEDENT   (* multi-line *)

AnnotationList      := AnnotationItem (AnnotationSep AnnotationItem)*

AnnotationSep       := COMMA | NEWLINE

AnnotationItem      := IRIExpr ASSIGN Expression AnnotationBlock?
                       (* recursive — supports nested annotations *)


(* ─── Expressions (precedence-ordered, low binding → high) ─── *)

Expression          := PipelineExpr

(* L1 — Pipeline, lowest precedence, left-assoc *)
PipelineExpr        := TernaryExpr (PIPE PipelineTarget)*
PipelineTarget      := PostfixExpr

(* L2 — Ternary, right-assoc *)
TernaryExpr         := OrExpr (T_QUESTION OrExpr T_COLON TernaryExpr)?

(* L3 — Or *)
OrExpr              := AndExpr ('or' AndExpr)*

(* L4 — And *)
AndExpr             := CompExpr ('and' CompExpr)*

(* L5 — Comparison, non-associative *)
CompExpr            := AdditiveExpr (CompOp AdditiveExpr)?
CompOp              := EQ | NEQ | LT | LE | GT | GE

(* L6 — Additive *)
AdditiveExpr        := MulExpr ((PLUS | MINUS) MulExpr)*

(* L7 — Multiplicative *)
MulExpr             := UnaryExpr ((STAR | SLASH | PERCENT) UnaryExpr)*

(* L8 — Unary *)
UnaryExpr           := MINUS UnaryExpr
                     | 'not' UnaryExpr
                     | PostfixExpr

(* L9 — Postfix (member access, function call), tightest *)
PostfixExpr         := PrimaryExpr (PostfixOp)*
PostfixOp           := DOT IDENT
                     | LPAREN ArgList? RPAREN

ArgList             := Arg (COMMA Arg)*
Arg                 := NamedArg | Expression
NamedArg            := IDENT ASSIGN Expression

(* Primary expressions *)
PrimaryExpr         := Literal
                     | FieldRef
                     | ENV_VAR
                     | IDENT
                     | IRIExpr
                     | LPAREN Expression RPAREN
                     | RecordLiteral
                     | TripleTerm

FieldRef            := DOT IDENT (DOT IDENT)*


(* ─── Literals ─── *)

Literal             := INTEGER | FLOAT | STRING | TEMPLATE
                     | InterpolatedString

(* A string with at least one hole. Both delimiters produce the same node, so
   nothing above the parser learns there were two spellings. *)
InterpolatedString  := STRING_OPEN (STRING_TEXT | Interpolation)* STRING_CLOSE
Interpolation       := INTERP_OPEN (Expression | PrefixRef) RBRACE

(* `${ex:}` — a prefix with no local part. It is NOT an expression, and it is
   admitted HERE and nowhere else: it is the CURIE-with-holes that the seventh
   amendment retires along with the backtick, and it dies with the last fixture
   that spells one. *)
PrefixRef           := IDENT SHAPE_SEP


(* ─── IRI expressions ─── *)

IRIExpr             := ABS_IRI
                     | PrefixedName
                     | TEMPLATE                  (* yielding IRI per context type *)
                     | InterpolatedString        (* likewise — the position types it *)

PrefixedName        := IDENT SHAPE_SEP LocalName
                       (* lexer-level: no whitespace between IDENT and ':' *)
LocalName           := IDENT


(* ─── Record literals (blank node value position) ─── *)

RecordLiteral       := LBRACE RecordBody RBRACE
RecordBody          := RecordField (RecordSep RecordField)*
                     | (* empty *)
RecordSep           := COMMA | NEWLINE
RecordField         := (IDENT | IRIExpr) ASSIGN Expression


(* ─── Triple terms (RDF 1.2 quoted triple) ─── *)

TripleTerm          := TRIPLE_OPEN Expression Expression Expression TRIPLE_CLOSE


(* ═══ DISAMBIGUATION RULES (parser context) ═══ *)

(*  1. RecordLiteral vs AnnotationBlock                                   *)
(*     - `prop = { ... }`     → RecordLiteral  (LBRACE immediately after  *)
(*                                              ASSIGN)                   *)
(*     - `prop = expr { ... }` → AnnotationBlock (LBRACE after an         *)
(*                                                Expression)             *)
(*                                                                         *)
(*  2. DOT IDENT vs FieldRef                                              *)
(*     - `namespace.ident`    → PostfixOp on `namespace`                   *)
(*     - `.ident` (no preceding expression) → FieldRef (current row)      *)
(*                                                                         *)
(*  3. SHAPE_SEP `:` vs T_COLON `:`                                       *)
(*     - `Name : Shape`       → SHAPE_SEP in MappingHeader                 *)
(*     - `cond ? a : b`       → T_COLON in TernaryExpr (paired with `?`)  *)
(*                                                                         *)
(*  4. Triple-term `<<` vs comparison `<`                                  *)
(*     - Lexer-level: `<<` is single token TRIPLE_OPEN                     *)
(*     - Single `<` is LT                                                  *)


(* ═══ RESERVED KEYWORDS (cannot be identifiers) ═══ *)

(*  prefix   in       from     use      as                                *)
(*  and      or       not      iri                                        *)
(*                                                                         *)
(*  There is no attribute keyword. `@name` lexes as AT_ATTR and the only  *)
(*  production that accepts one is SubjectAttr, whose name must be        *)
(*  `subject`. The sigil IS decided and it is `@`                         *)
(*  (ADR-0057, fourth amendment): `#` is unlexable here, is Turtle's      *)
(*  comment character, and is RDF's fragment separator. `@` is shared     *)
(*  with keasy's connection aliases, which live inside string literals,   *)
(*  so the two never cross lexically.                                     *)


(* ═══ OPERATOR PRECEDENCE TABLE ═══ *)

(*  Level   Operators                    Associativity                   *)
(*  ─────   ─────────────────────────    ─────────────                   *)
(*   L1     |>                            left-assoc                      *)
(*   L2     ? :                           right-assoc                     *)
(*   L3     or                            left-assoc                      *)
(*   L4     and                           left-assoc                      *)
(*   L5     == != < <= > >=               non-assoc                       *)
(*   L6     + -                           left-assoc                      *)
(*   L7     * / %                         left-assoc                      *)
(*   L8     - (unary), not                right-assoc                     *)
(*   L9     . (member), ( ) (call)        left-assoc                      *)


(* ═══ NOT IN MVP (productions intentionally absent) ═══ *)

(*  LambdaExpr        — no user-defined multi-arg lambdas                 *)
(*  MatchExpr         — no pattern matching (use multiple mappings)       *)
(*  IfThenElseExpr    — only via ternary `?:`                              *)
(*  ExternDecl        — no `extern` declarations in MVP                    *)
(*  WhileLoop/ForLoop — no imperative control flow                         *)
(*  MutableBinding    — no mutation                                        *)
(*  TypeAnnotation    — no `f :: T -> U` over a value; nothing reads one   *)
(*  ExportedDefinition— no `@export`; there is no module system to export  *)
(*                      to, so the marker named nobody                     *)
(*  PartialPlaceholder— no `f(_, x)`; `_` is an ordinary identifier        *)
(*  Type parameters   — no generics                                        *)
(*                                                                         *)
(*  This file describes the language, not the parser's tolerance. A form   *)
(*  no downstream stage reads does not belong here — it is a promise the   *)
(*  language does not keep.                                                *)
