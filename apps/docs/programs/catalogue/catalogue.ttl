PREFIX sh:   <http://www.w3.org/ns/shacl#>
PREFIX shop: <https://shop.example/voc#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

shop:ProductShape
    a sh:NodeShape ;
    sh:targetClass shop:Product ;
    sh:property [
        sh:path     shop:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path     shop:price ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
