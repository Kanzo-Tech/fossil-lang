// GTFS-Madrid-Bench's CSV distribution, mapped to the graph its upstream RML mapping
// (`mappings/gtfs-csv.rml.ttl`) defines: one mapping per triples map there, in its order.
//
// Where the two are not the same text:
// - an upstream referencing object map joined on the parent's key is an edge here, which
//   fossil resolves against the target's vertices; the generator's keys resolve, so the
//   two agree;
// - `shapes_0` joins SHAPES to itself on `shape_id` to link a shape to its points, which is
//   quadratic in the points of a shape (107 million pairs at scale 1) and defines the triples
//   reading each point once does; `Shapes` reads each point once;
// - `serviceRule` points at a rule built from the same row, which the upstream mapping spells
//   as a join of a file with itself on `service_id`, and this as an edge to that rule.

type { Agency, CalendarDateRule, CalendarRule, Feed, Frequency, Route, Service, ShapePoint, Shape, Stop, StopTime, Trip } := io.shex("gtfs.shex")

AgencyRow   := io.csv("data/AGENCY.csv")
DateRow     := io.csv("data/CALENDAR_DATES.csv")
CalendarRow := io.csv("data/CALENDAR.csv")
FeedRow     := io.csv("data/FEED_INFO.csv")
FreqRow     := io.csv("data/FREQUENCIES.csv")
RouteRow    := io.csv("data/ROUTES.csv")
PointRow    := io.csv("data/SHAPES.csv")
StopRow     := io.csv("data/STOPS.csv")
TimeRow     := io.csv("data/STOP_TIMES.csv")
TripRow     := io.csv("data/TRIPS.csv")

Agencies : Agency from AgencyRow
    @subject = "http://transport.linkeddata.es/madrid/agency/{AgencyRow.agency_id}"
    page     = AgencyRow.agency_url
    name     = AgencyRow.agency_name
    timeZone = AgencyRow.agency_timezone
    language = AgencyRow.agency_lang
    phone    = AgencyRow.agency_phone
    fareUrl  = AgencyRow.agency_fare_url

DateRules : CalendarDateRule from DateRow
    @subject     = "http://transport.linkeddata.es/madrid/metro/calendar_date_rule/{DateRow.service_id}-{DateRow.date}"
    date         = DateRow.date
    dateAddition = DateRow.exception_type == 1

CalendarRules : CalendarRule from CalendarRow
    @subject  = "http://transport.linkeddata.es/madrid/metro/calendar_rules/{CalendarRow.service_id}"
    monday    = CalendarRow.monday == 1
    tuesday   = CalendarRow.tuesday == 1
    wednesday = CalendarRow.wednesday == 1
    thursday  = CalendarRow.thursday == 1
    friday    = CalendarRow.friday == 1
    saturday  = CalendarRow.saturday == 1
    sunday    = CalendarRow.sunday == 1
    startDate = CalendarRow.start_date
    endDate   = CalendarRow.end_date

Feeds : Feed from FeedRow
    @subject  = "http://transport.linkeddata.es/madrid/metro/feed/{FeedRow.feed_publisher_name}"
    publisher = FeedRow.feed_publisher_name
    page      = FeedRow.feed_publisher_url
    language  = FeedRow.feed_lang
    startDate = FeedRow.feed_start_date
    endDate   = FeedRow.feed_end_date
    version   = FeedRow.feed_version

Frequencies : Frequency from FreqRow
    @subject       = "http://transport.linkeddata.es/madrid/metro/frequency/{FreqRow.trip_id}-{FreqRow.start_time}"
    startTime      = FreqRow.start_time
    endTime        = FreqRow.end_time
    headwaySeconds = FreqRow.headway_secs
    exactTimes     = FreqRow.exact_times == 1
    trip           = Trip(FreqRow.trip_id)

Routes : Route from RouteRow
    @subject    = "http://transport.linkeddata.es/madrid/metro/routes/{RouteRow.route_id}"
    shortName   = RouteRow.route_short_name
    longName    = RouteRow.route_long_name
    description = RouteRow.route_desc
    routeType   = "http://transport.linkeddata.es/resource/RouteType/{RouteRow.route_type}"
    routeUrl    = RouteRow.route_url
    color       = RouteRow.route_color
    textColor   = RouteRow.route_text_color
    agency      = Agency(RouteRow.agency_id)

ServicesByCalendar : Service from CalendarRow
    @subject    = "http://transport.linkeddata.es/madrid/metro/services/{CalendarRow.service_id}"
    serviceRule = CalendarRule(CalendarRow.service_id)

ServicesByDate : Service from DateRow
    @subject    = "http://transport.linkeddata.es/madrid/metro/services/{DateRow.service_id}"
    serviceRule = CalendarDateRule(DateRow.service_id, DateRow.date)

ShapePoints : ShapePoint from PointRow
    @subject         = "http://transport.linkeddata.es/madrid/metro/shape_point/{PointRow.shape_id}-{PointRow.shape_pt_sequence}"
    lat              = PointRow.shape_pt_lat
    long             = PointRow.shape_pt_lon
    pointSequence    = "{PointRow.shape_pt_sequence}"
    distanceTraveled = PointRow.shape_dist_traveled

Shapes : Shape from PointRow
    @subject   = "http://transport.linkeddata.es/madrid/metro/shape/{PointRow.shape_id}"
    shapePoint = ShapePoint(PointRow.shape_id, PointRow.shape_pt_sequence)

Stops : Stop from StopRow
    @subject             = "http://transport.linkeddata.es/madrid/metro/stops/{StopRow.stop_id}"
    code                 = StopRow.stop_code
    identifier           = StopRow.stop_id
    name                 = StopRow.stop_name
    description          = StopRow.stop_desc
    lat                  = StopRow.stop_lat
    long                 = StopRow.stop_lon
    zone                 = StopRow.zone_id
    locationType         = "http://transport.linkeddata.es/resource/LocationType/{StopRow.location_type}"
    page                 = StopRow.stop_url
    timeZone             = StopRow.stop_timezone
    wheelchairAccessible = "http://transport.linkeddata.es/resource/WheelchairBoardingStatus/{StopRow.wheelchair_boarding}"
    parentStation        = Stop(StopRow.parent_station)

StopTimes : StopTime from TimeRow
    @subject         = "http://transport.linkeddata.es/madrid/metro/stoptimes/{TimeRow.trip_id}-{TimeRow.stop_id}-{TimeRow.arrival_time}"
    arrivalTime      = TimeRow.arrival_time
    departureTime    = TimeRow.departure_time
    stopSequence     = TimeRow.stop_sequence
    headsign         = TimeRow.stop_headsign
    pickupType       = "http://transport.linkeddata.es/resource/PickupType/{TimeRow.pickup_type}"
    dropOffType      = "http://transport.linkeddata.es/resource/DropOffType/{TimeRow.drop_off_type}"
    distanceTraveled = TimeRow.shape_dist_traveled
    trip             = Trip(TimeRow.trip_id)
    stop             = Stop(TimeRow.stop_id)

Trips : Trip from TripRow
    @subject             = "http://transport.linkeddata.es/madrid/metro/trips/{TripRow.trip_id}"
    headsign             = TripRow.trip_headsign
    shortName            = TripRow.trip_short_name
    direction            = "{TripRow.direction_id}"
    block                = TripRow.block_id
    wheelchairAccessible = "http://transport.linkeddata.es/resource/WheelchairBoardingStatus/{TripRow.wheelchair_accessible}"
    service              = Service(TripRow.service_id)
    route                = Route(TripRow.route_id)
    shape                = Shape(TripRow.shape_id)
