# GTFS-Madrid-Bench's graph (mappings/gtfs-csv.rml.ttl, upstream), as the shapes fossil maps to.
# One shape per class the upstream mapping types its subjects with, one triple constraint per
# predicate it writes, and every value optional: the generated CSV leaves columns empty, and an
# RML processor writes nothing for an empty value.
PREFIX gtfs:   <http://vocab.gtfs.org/terms#>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX schema: <http://schema.org/>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

gtfs:Agency {
  foaf:page      IRI ? ;
  foaf:name      xsd:string ? ;
  gtfs:timeZone  xsd:string ? ;
  dct:language   xsd:string ? ;
  foaf:phone     xsd:string ? ;
  gtfs:fareUrl   IRI ?
}

gtfs:CalendarDateRule {
  dct:date          xsd:date ? ;
  gtfs:dateAddition xsd:boolean ?
}

gtfs:CalendarRule {
  gtfs:monday       xsd:boolean ? ;
  gtfs:tuesday      xsd:boolean ? ;
  gtfs:wednesday    xsd:boolean ? ;
  gtfs:thursday     xsd:boolean ? ;
  gtfs:friday       xsd:boolean ? ;
  gtfs:saturday     xsd:boolean ? ;
  gtfs:sunday       xsd:boolean ? ;
  schema:startDate  xsd:date ? ;
  schema:endDate    xsd:date ?
}

gtfs:Feed {
  dct:publisher    xsd:string ? ;
  foaf:page        IRI ? ;
  dct:language     xsd:string ? ;
  schema:startDate xsd:date ? ;
  schema:endDate   xsd:date ? ;
  schema:version   xsd:string ?
}

gtfs:Frequency {
  gtfs:startTime      xsd:string ? ;
  gtfs:endTime        xsd:string ? ;
  gtfs:headwaySeconds xsd:integer ? ;
  gtfs:exactTimes     xsd:boolean ? ;
  gtfs:trip           @gtfs:Trip ?
}

gtfs:Route {
  gtfs:shortName  xsd:string ? ;
  gtfs:longName   xsd:string ? ;
  dct:description xsd:string ? ;
  gtfs:routeType  IRI ? ;
  gtfs:routeUrl   IRI ? ;
  gtfs:color      xsd:string ? ;
  gtfs:textColor  xsd:string ? ;
  gtfs:agency     @gtfs:Agency ?
}

gtfs:Service {
  gtfs:serviceRule @gtfs:CalendarRule OR @gtfs:CalendarDateRule *
}

gtfs:ShapePoint {
  geo:lat               xsd:double ? ;
  geo:long              xsd:double ? ;
  gtfs:pointSequence    xsd:string ? ;
  gtfs:distanceTraveled xsd:double ?
}

gtfs:Shape {
  gtfs:shapePoint @gtfs:ShapePoint *
}

gtfs:Stop {
  gtfs:code                 xsd:string ? ;
  dct:identifier            xsd:string ? ;
  foaf:name                 xsd:string ? ;
  dct:description           xsd:string ? ;
  geo:lat                   xsd:double ? ;
  geo:long                  xsd:double ? ;
  gtfs:zone                 xsd:string ? ;
  gtfs:locationType         IRI ? ;
  foaf:page                 IRI ? ;
  gtfs:timeZone             xsd:string ? ;
  gtfs:wheelchairAccessible IRI ? ;
  gtfs:parentStation        @gtfs:Stop ?
}

gtfs:StopTime {
  gtfs:arrivalTime      xsd:string ? ;
  gtfs:departureTime    xsd:string ? ;
  gtfs:stopSequence     xsd:integer ? ;
  gtfs:headsign         xsd:string ? ;
  gtfs:pickupType       IRI ? ;
  gtfs:dropOffType      IRI ? ;
  gtfs:distanceTraveled xsd:double ? ;
  gtfs:trip             @gtfs:Trip ? ;
  gtfs:stop             @gtfs:Stop ?
}

gtfs:Trip {
  gtfs:headsign             xsd:string ? ;
  gtfs:shortName            xsd:string ? ;
  gtfs:direction            xsd:string ? ;
  gtfs:block                xsd:string ? ;
  gtfs:wheelchairAccessible IRI ? ;
  gtfs:service              @gtfs:Service ? ;
  gtfs:route                @gtfs:Route ? ;
  gtfs:shape                @gtfs:Shape ?
}
