# docs/programs/hello in RML-Core, for the RML processors the benchmark compares against.
@base <https://bench.fossil.test/mapping> .
@prefix rml:  <http://w3id.org/rml/> .
@prefix shop: <https://shop.example/voc#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<#People> a rml:TriplesMap ;
  rml:logicalSource [
    rml:source [ a rml:RelativePathSource ; rml:root rml:MappingDirectory ; rml:path "data/people.csv" ] ;
    rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "https://shop.example/person/{id}" ; rml:class shop:Person ] ;
  rml:predicateObjectMap [ rml:predicate shop:name ;
    rml:objectMap [ rml:reference "name" ; rml:datatype xsd:string ] ] .
