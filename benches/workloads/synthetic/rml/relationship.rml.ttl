# docs/programs/relationship in RML-Core, over LDBC-SNB's `|`-delimited files (a CSVW
# dialect). The program reaches `knows` and `hasInterest` by joining `person.csv` to the
# relationship file; here each relationship file is a triples map of its own whose subject
# is the person's template, which defines the same triples when every id resolves — the
# generator makes sure it does.
@base <https://bench.fossil.test/mapping> .
@prefix rml:  <http://w3id.org/rml/> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix snb:  <https://ldbc.example/voc#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<#Places> a rml:TriplesMap ;
  rml:logicalSource [
    rml:source [ a csvw:Table ; csvw:url "data/place.csv" ;
      csvw:dialect [ a csvw:Dialect ; csvw:delimiter "|" ] ] ;
    rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "https://ldbc.example/place/{id}" ; rml:class snb:Place ] ;
  rml:predicateObjectMap [ rml:predicate snb:name ;
    rml:objectMap [ rml:reference "name" ; rml:datatype xsd:string ] ] .

<#Tags> a rml:TriplesMap ;
  rml:logicalSource [
    rml:source [ a csvw:Table ; csvw:url "data/tag.csv" ;
      csvw:dialect [ a csvw:Dialect ; csvw:delimiter "|" ] ] ;
    rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "https://ldbc.example/tag/{id}" ; rml:class snb:Tag ] ;
  rml:predicateObjectMap [ rml:predicate snb:name ;
    rml:objectMap [ rml:reference "name" ; rml:datatype xsd:string ] ] .

<#People> a rml:TriplesMap ;
  rml:logicalSource [
    rml:source [ a csvw:Table ; csvw:url "data/person.csv" ;
      csvw:dialect [ a csvw:Dialect ; csvw:delimiter "|" ] ] ;
    rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "https://ldbc.example/person/{id}" ; rml:class snb:Person ] ;
  rml:predicateObjectMap [ rml:predicate snb:firstName ;
    rml:objectMap [ rml:reference "firstName" ; rml:datatype xsd:string ] ] ;
  rml:predicateObjectMap [ rml:predicate snb:isLocatedIn ;
    rml:objectMap [ rml:template "https://ldbc.example/place/{place}" ] ] .

<#Knows> a rml:TriplesMap ;
  rml:logicalSource [
    rml:source [ a csvw:Table ; csvw:url "data/person_knows_person.csv" ;
      csvw:dialect [ a csvw:Dialect ; csvw:delimiter "|" ] ] ;
    rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "https://ldbc.example/person/{Person.id}" ] ;
  rml:predicateObjectMap [ rml:predicate snb:knows ;
    rml:objectMap [ rml:template "https://ldbc.example/person/{Person.id_1}" ] ] .

<#Interests> a rml:TriplesMap ;
  rml:logicalSource [
    rml:source [ a csvw:Table ; csvw:url "data/person_hasInterest_tag.csv" ;
      csvw:dialect [ a csvw:Dialect ; csvw:delimiter "|" ] ] ;
    rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "https://ldbc.example/person/{Person.id}" ] ;
  rml:predicateObjectMap [ rml:predicate snb:hasInterest ;
    rml:objectMap [ rml:template "https://ldbc.example/tag/{Tag.id}" ] ] .
