# The output contract of `fossil-df-wasm/tests/execute_core.rs`.
#
# `csv_program_runs_through_the_in_memory_source_seam` and
# `at_conn_source_alias_resolves_through_the_ref_map` need only `ex:Person`;
# `program_sources_lists_each_distinct_source_with_its_format` also needs
# `ex:Order`, whose `placedBy` is a shape-ref (an edge).
#
# Every program there names it, and the test registers it under the key
# `missing_documents` reports — the checker and the run read that one copy.
#
# The name order is load-bearing: `type { Person, Order } := …` binds
# POSITIONALLY, so `Person` is whatever this file declares FIRST.
PREFIX ex: <https://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:Person {
  ex:name xsd:string
}

ex:Order {
  ex:placedBy @ex:Person
}
