---
source: crates/fossil-graph/tests/schemas.rs
expression: schema_for! (Operation)
---
$schema: "http://json-schema.org/draft-07/schema#"
title: Operation
description: "All graph operations dispatchable on the surface.\n\nThe `tag = \"verb\"` serde representation makes the wire form `{ \"verb\": \"schema\", \"params\": { … } }` — identical for MCP tool calls, HTTP POST bodies, and CLI subcommand args."
oneOf:
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/SchemaParams"
      verb:
        type: string
        enum:
          - schema
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/FindNeighborsParams"
      verb:
        type: string
        enum:
          - find_neighbors
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/FindPathParams"
      verb:
        type: string
        enum:
          - find_path
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/GetVertexParams"
      verb:
        type: string
        enum:
          - get_vertex
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/AggregateParams"
      verb:
        type: string
        enum:
          - aggregate
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/TopKParams"
      verb:
        type: string
        enum:
          - top_k
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ViewportParams"
      verb:
        type: string
        enum:
          - viewport
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/MaterializeGraphParams"
      verb:
        type: string
        enum:
          - materialize_graph
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ExecuteSqlParams"
      verb:
        type: string
        enum:
          - execute_sql
definitions:
  AggregateParams:
    description: "One grouping, over values or over ranges.\n\n**Binning is grouping**, which is why `histogram` is not a second verb: it was the same `GROUP BY` with the key computed from a range instead of read from a column. Setting [`Self::bins`] is what picks which, and it is the only difference between the two."
    type: object
    required:
      - agg
      - group_by
      - vertex_type
    properties:
      agg:
        $ref: "#/definitions/Aggregation"
      bins:
        description: "Group over this many equal-width ranges of `group_by` rather than over its distinct values — what `histogram` used to be. Requires a numeric or temporal column: a categorical one has no ranges, and grouping it by value is already the answer."
        default: ~
        type:
          - integer
          - "null"
        format: uint32
        minimum: 0
      group_by:
        description: "The column the groups come from — its values, or its ranges when [`Self::bins`] is set."
        type: string
      limit:
        description: "Cap on rows returned. Groups are ordered by value and cut here; a binned call is cut to this many bins instead, so `limit` means one thing."
        default: 1000
        type: integer
        format: uint32
        minimum: 0
      measure:
        description: "Optional measure column for `sum`/`avg`/`min`/`max` aggregations. Ignored when `agg` is `count`."
        default: ~
        type:
          - string
          - "null"
      vertex_type:
        type: string
    additionalProperties: false
  Aggregation:
    type: string
    enum:
      - count
      - sum
      - avg
      - min
      - max
  BoundingBox:
    type: object
    required:
      - x_max
      - x_min
      - y_max
      - y_min
    properties:
      x_max:
        type: number
        format: float
      x_min:
        type: number
        format: float
      y_max:
        type: number
        format: float
      y_min:
        type: number
        format: float
  ExecuteSqlParams:
    type: object
    required:
      - sql
    properties:
      row_cap:
        description: "Hard cap on rows returned to the caller. The executor MUST apply an outer `LIMIT` regardless of what the user's SQL contains."
        default: 10000
        type: integer
        format: uint32
        minimum: 0
      sql:
        type: string
      timeout_ms:
        description: "Hard cap on wall-clock execution time, milliseconds."
        default: 10000
        type: integer
        format: uint32
        minimum: 0
    additionalProperties: false
  FindNeighborsParams:
    type: object
    required:
      - iri
    properties:
      depth:
        default: 1
        type: integer
        format: uint8
        minimum: 0
      edge_types:
        description: Restrict traversal to a subset of edge names. Empty = all.
        default: []
        type: array
        items:
          type: string
      iri:
        type: string
      limit:
        default: 500
        type: integer
        format: uint32
        minimum: 0
    additionalProperties: false
  FindPathParams:
    type: object
    required:
      - source_iri
      - target_iri
    properties:
      max_hops:
        default: 5
        type: integer
        format: uint8
        minimum: 0
      source_iri:
        type: string
      target_iri:
        type: string
    additionalProperties: false
  GetVertexParams:
    type: object
    required:
      - subject
      - vertex_type
    properties:
      subject:
        description: "The vertex's `subject` IRI (unique across the graph)."
        type: string
      vertex_type:
        type: string
    additionalProperties: false
  MaterializeGraphParams:
    type: object
    properties:
      limit:
        default: 50000
        type: integer
        format: uint32
        minimum: 0
      vertex_types:
        description: Restrict to a subset of vertex types. Empty = all.
        default: []
        type: array
        items:
          type: string
    additionalProperties: false
  SchemaParams:
    type: object
    properties:
      field:
        description: "Name a field to narrow the statistics to it and pick up its samples. Ignored without `vertex_type`."
        default: ~
        type:
          - string
          - "null"
      vertex_type:
        description: "Name a vertex type to also get its per-field statistics. Omitted, the answer is the type lists alone and no field is queried."
        default: ~
        type:
          - string
          - "null"
    additionalProperties: false
  TopKParams:
    type: object
    required:
      - order_by
      - vertex_type
    properties:
      descending:
        default: false
        type: boolean
      k:
        default: 20
        type: integer
        format: uint32
        minimum: 0
      order_by:
        type: string
      vertex_type:
        type: string
    additionalProperties: false
  ViewportParams:
    type: object
    required:
      - bbox
      - zoom
    properties:
      bbox:
        $ref: "#/definitions/BoundingBox"
      limit:
        default: 500000
        type: integer
        format: uint32
        minimum: 0
      lod_threshold:
        default: 0.5
        type: number
        format: float
      vertex_types:
        description: Restrict to a subset of vertex types. Empty = all.
        default: []
        type: array
        items:
          type: string
      zoom:
        description: "Current zoom level. Above [`Self::lod_threshold`] the executor swaps to aggregate mode (`GROUP BY cluster_id`) returning ≤ 10k super-nodes regardless of total N."
        type: number
        format: float
    additionalProperties: false
