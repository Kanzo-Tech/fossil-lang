---
source: crates/fossil-graph/tests/schemas.rs
expression: schema_for! (Operation)
---
$schema: "http://json-schema.org/draft-07/schema#"
title: Operation
description: "All graph operations dispatchable on the surface.\n\nThe `tag = \"verb\"` serde representation makes the wire form `{ \"verb\": \"schema\", \"params\": { … } }` — identical for MCP tool calls, HTTP POST bodies, and CLI subcommand args."
oneOf:
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/SchemaParams"
      verb:
        type: string
        enum:
          - schema
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ReadParams"
      verb:
        type: string
        enum:
          - read
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ExpandParams"
      verb:
        type: string
        enum:
          - expand
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/PathParams"
      verb:
        type: string
        enum:
          - path
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/AggregateParams"
      verb:
        type: string
        enum:
          - aggregate
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ViewportParams"
      verb:
        type: string
        enum:
          - viewport
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/MaterializeGraphParams"
      verb:
        type: string
        enum:
          - materialize_graph
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ExecuteSqlParams"
      verb:
        type: string
        enum:
          - execute_sql
definitions:
  AggregateParams:
    description: "One grouping, over values or over ranges.\n\n**Binning is grouping**, which is why `histogram` is not a second verb: it was the same `GROUP BY` with the key computed from a range instead of read from a column. Setting [`Self::bins`] is what picks which, and it is the only difference between the two."
    type: object
    required:
      - agg
      - group_by
      - vertex_type
    properties:
      agg:
        $ref: "#/definitions/Aggregation"
      bins:
        description: "Group over this many equal-width ranges of `group_by` rather than over its distinct values — what `histogram` used to be. Requires a numeric or temporal column: a categorical one has no ranges, and grouping it by value is already the answer."
        default: ~
        type:
          - integer
          - "null"
        format: uint32
        minimum: 0
      group_by:
        description: "The column the groups come from — its values, or its ranges when [`Self::bins`] is set."
        type: string
      limit:
        description: "Cap on rows returned. Groups are ordered by value and cut here; a binned call is cut to this many bins instead, so `limit` means one thing."
        default: 1000
        type: integer
        format: uint32
        minimum: 0
      measure:
        description: "Optional measure column for `sum`/`avg`/`min`/`max` aggregations. Ignored when `agg` is `count`."
        default: ~
        type:
          - string
          - "null"
      vertex_type:
        type: string
    additionalProperties: false
  Aggregation:
    type: string
    enum:
      - count
      - sum
      - avg
      - min
      - max
  BoundingBox:
    type: object
    required:
      - x_max
      - x_min
      - y_max
      - y_min
    properties:
      x_max:
        type: number
        format: float
      x_min:
        type: number
        format: float
      y_max:
        type: number
        format: float
      y_min:
        type: number
        format: float
  ExecuteSqlParams:
    type: object
    required:
      - sql
    properties:
      row_cap:
        description: "Hard cap on rows returned to the caller. The executor MUST apply an outer `LIMIT` regardless of what the user's SQL contains."
        default: 10000
        type: integer
        format: uint32
        minimum: 0
      sql:
        type: string
      timeout_ms:
        description: "Hard cap on wall-clock execution time, milliseconds."
        default: 10000
        type: integer
        format: uint32
        minimum: 0
    additionalProperties: false
  ExpandMode:
    description: "Which edges an expansion keeps — Neo4j's `Expand(All)` / `Expand(Into)`."
    oneOf:
      - description: "Walk outward: every edge leaving the frontier, up to `depth`."
        type: string
        enum:
          - all
      - description: "The subgraph induced on `from`: only edges whose **both** ends are in the set.\n\n**The form is right and the speed argument is not available here.** ADR-0041 justified this mode by the membership mask Kùzu (`SEMI_MASKER`) and Neo4j push inside the scan; ADR-0042 measured that `DuckDB` does not accept that class of pruning — a range join against the ids costs more than not pruning at all. So this is a shape a caller wants, not a fast path we have."
        type: string
        enum:
          - into
  ExpandParams:
    type: object
    required:
      - from
    properties:
      depth:
        description: "Hops to walk. [`ExpandMode::Into`] ignores it — the induced subgraph has no frontier to advance."
        default: 1
        type: integer
        format: uint8
        minimum: 0
      edge_types:
        description: Restrict traversal to a subset of edge names. Empty = all.
        default: []
        type: array
        items:
          type: string
      from:
        description: "The vertices to expand from, by subject IRI."
        type: array
        items:
          type: string
      limit:
        default: 500
        type: integer
        format: uint32
        minimum: 0
      mode:
        default: all
        allOf:
          - $ref: "#/definitions/ExpandMode"
    additionalProperties: false
  MaterializeGraphParams:
    type: object
    properties:
      limit:
        default: 50000
        type: integer
        format: uint32
        minimum: 0
      vertex_types:
        description: Restrict to a subset of vertex types. Empty = all.
        default: []
        type: array
        items:
          type: string
    additionalProperties: false
  PathParams:
    type: object
    required:
      - source_iri
      - target_iri
    properties:
      max_hops:
        default: 5
        type: integer
        format: uint8
        minimum: 0
      source_iri:
        type: string
      target_iri:
        type: string
    additionalProperties: false
  ReadParams:
    description: "Rows of one vertex type, filtered, ordered and capped.\n\n**`where` is SQL and is trusted exactly as far as `execute_sql` is.** A binding that gates the escape hatch behind a permission MUST gate this field with it: the two carry the same authority over the same engine."
    type: object
    required:
      - vertex_type
    properties:
      descending:
        default: false
        type: boolean
      limit:
        default: 100
        type: integer
        format: uint32
        minimum: 0
      order_by:
        description: "Column to order by. Absent, the rows arrive in storage order, which is the writer's Morton order and says nothing the caller asked about."
        default: ~
        type:
          - string
          - "null"
      vertex_type:
        type: string
      where:
        description: "A `WHERE` predicate over the type's columns, without the keyword. Reading one vertex is `subject = '…'`."
        default: ~
        type:
          - string
          - "null"
    additionalProperties: false
  SchemaParams:
    type: object
    properties:
      field:
        description: "Name a field to narrow the statistics to it and pick up its samples. Ignored without `vertex_type`."
        default: ~
        type:
          - string
          - "null"
      vertex_type:
        description: "Name a vertex type to also get its per-field statistics. Omitted, the answer is the type lists alone and no field is queried."
        default: ~
        type:
          - string
          - "null"
    additionalProperties: false
  ViewportParams:
    type: object
    required:
      - bbox
      - zoom
    properties:
      bbox:
        $ref: "#/definitions/BoundingBox"
      limit:
        default: 500000
        type: integer
        format: uint32
        minimum: 0
      lod_threshold:
        default: 0.5
        type: number
        format: float
      vertex_types:
        description: Restrict to a subset of vertex types. Empty = all.
        default: []
        type: array
        items:
          type: string
      zoom:
        description: "Current zoom level. Above [`Self::lod_threshold`] the executor swaps to aggregate mode (`GROUP BY cluster_id`) returning ≤ 10k super-nodes regardless of total N."
        type: number
        format: float
    additionalProperties: false
