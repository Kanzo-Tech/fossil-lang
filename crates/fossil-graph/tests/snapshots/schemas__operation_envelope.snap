---
source: crates/fossil-graph/tests/schemas.rs
expression: schema_for! (Operation)
---
$schema: "http://json-schema.org/draft-07/schema#"
title: Operation
description: "All graph operations dispatchable on the surface.\n\nThe `tag = \"verb\"` serde representation makes the wire form `{ \"verb\": \"list_vertex_types\", \"params\": { … } }` — identical for MCP tool calls, HTTP POST bodies, and CLI subcommand args."
oneOf:
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ListVertexTypesParams"
      verb:
        type: string
        enum:
          - list_vertex_types
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ListEdgeTypesParams"
      verb:
        type: string
        enum:
          - list_edge_types
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/DescribeFieldParams"
      verb:
        type: string
        enum:
          - describe_field
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/SearchByLabelParams"
      verb:
        type: string
        enum:
          - search_by_label
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/FindNeighborsParams"
      verb:
        type: string
        enum:
          - find_neighbors
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/FindPathParams"
      verb:
        type: string
        enum:
          - find_path
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/AggregateParams"
      verb:
        type: string
        enum:
          - aggregate
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/HistogramParams"
      verb:
        type: string
        enum:
          - histogram
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/TopKParams"
      verb:
        type: string
        enum:
          - top_k
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/SummarizeClusterParams"
      verb:
        type: string
        enum:
          - summarize_cluster
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/AnswerWithCommunitiesParams"
      verb:
        type: string
        enum:
          - answer_with_communities
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ViewportParams"
      verb:
        type: string
        enum:
          - viewport
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/SetSelectionParams"
      verb:
        type: string
        enum:
          - set_selection
  - type: object
    required:
      - params
      - verb
    properties:
      params:
        $ref: "#/definitions/ExecuteSqlParams"
      verb:
        type: string
        enum:
          - execute_sql
definitions:
  AggregateParams:
    type: object
    required:
      - agg
      - group_by
      - vertex_type
    properties:
      agg:
        $ref: "#/definitions/Aggregation"
      group_by:
        type: string
      limit:
        default: 1000
        type: integer
        format: uint32
        minimum: 0
      measure:
        description: "Optional measure column for `sum`/`avg`/`min`/`max` aggregations. Ignored when `agg` is `count`."
        default: ~
        type:
          - string
          - "null"
      vertex_type:
        type: string
    additionalProperties: false
  Aggregation:
    type: string
    enum:
      - count
      - sum
      - avg
      - min
      - max
  AnswerWithCommunitiesParams:
    type: object
    required:
      - question
    properties:
      max_communities:
        description: "Cap on how many cluster summaries the LLM may pull as context. The Microsoft `GraphRAG` paper recommends 5–10; defaulting low to match."
        default: 8
        type: integer
        format: uint8
        minimum: 0
      question:
        type: string
    additionalProperties: false
  BoundingBox:
    type: object
    required:
      - x_max
      - x_min
      - y_max
      - y_min
    properties:
      x_max:
        type: number
        format: float
      x_min:
        type: number
        format: float
      y_max:
        type: number
        format: float
      y_min:
        type: number
        format: float
  DescribeFieldParams:
    type: object
    required:
      - field
      - vertex_type
    properties:
      field:
        type: string
      vertex_type:
        type: string
    additionalProperties: false
  ExecuteSqlParams:
    type: object
    required:
      - sql
    properties:
      row_cap:
        description: "Hard cap on rows returned to the caller. The executor MUST apply an outer `LIMIT` regardless of what the user's SQL contains."
        default: 10000
        type: integer
        format: uint32
        minimum: 0
      sql:
        type: string
      timeout_ms:
        description: "Hard cap on wall-clock execution time, milliseconds."
        default: 10000
        type: integer
        format: uint32
        minimum: 0
    additionalProperties: false
  FindNeighborsParams:
    type: object
    required:
      - iri
    properties:
      depth:
        default: 1
        type: integer
        format: uint8
        minimum: 0
      edge_types:
        description: Restrict traversal to a subset of edge names. Empty = all.
        default: []
        type: array
        items:
          type: string
      iri:
        type: string
      limit:
        default: 500
        type: integer
        format: uint32
        minimum: 0
    additionalProperties: false
  FindPathParams:
    type: object
    required:
      - source_iri
      - target_iri
    properties:
      max_hops:
        default: 5
        type: integer
        format: uint8
        minimum: 0
      source_iri:
        type: string
      target_iri:
        type: string
    additionalProperties: false
  HistogramParams:
    type: object
    required:
      - field
      - vertex_type
    properties:
      bins:
        default: 50
        type: integer
        format: uint32
        minimum: 0
      field:
        type: string
      vertex_type:
        type: string
    additionalProperties: false
  ListEdgeTypesParams:
    type: object
    additionalProperties: false
  ListVertexTypesParams:
    type: object
    additionalProperties: false
  SearchByLabelParams:
    type: object
    required:
      - query
    properties:
      query:
        type: string
      top_k:
        default: 20
        type: integer
        format: uint32
        minimum: 0
      vertex_types:
        description: Restrict the vector search to a subset of vertex types. Empty = all.
        default: []
        type: array
        items:
          type: string
    additionalProperties: false
  SetSelectionParams:
    type: object
    properties:
      selection:
        description: "Mosaic-Selection-compatible filter expression. `None` clears the current selection so the next viewport call returns the full bbox."
    additionalProperties: false
  SummarizeClusterParams:
    type: object
    required:
      - cluster_id
    properties:
      cluster_id:
        type: integer
        format: uint32
        minimum: 0
    additionalProperties: false
  TopKParams:
    type: object
    required:
      - order_by
      - vertex_type
    properties:
      descending:
        default: false
        type: boolean
      k:
        default: 20
        type: integer
        format: uint32
        minimum: 0
      order_by:
        type: string
      vertex_type:
        type: string
    additionalProperties: false
  ViewportParams:
    type: object
    required:
      - bbox
      - zoom
    properties:
      bbox:
        $ref: "#/definitions/BoundingBox"
      limit:
        default: 500000
        type: integer
        format: uint32
        minimum: 0
      lod_threshold:
        default: 0.5
        type: number
        format: float
      vertex_types:
        description: Restrict to a subset of vertex types. Empty = all.
        default: []
        type: array
        items:
          type: string
      zoom:
        description: "Current zoom level. Above [`Self::lod_threshold`] the executor swaps to aggregate mode (`GROUP BY cluster_id`) returning ≤ 10k super-nodes regardless of total N."
        type: number
        format: float
    additionalProperties: false
