---
source: crates/fossil-sinks/tests/manifest_yaml.rs
expression: "person_vertex().to_yaml().expect(\"vertex serialization\")"
---
type: Person
vertex_count: 10000
chunk_size: 4096
prefix: vertex/person/
projections:
- path: ''
  scale: 1
  file_type: parquet
  properties:
  - name: id
    data_type: int64
    is_primary: true
    is_nullable: false
    cardinality: single
  - name: name
    data_type: string
    is_primary: false
coordinates:
- name: geo
  x: lon
  y: lat
  provenance: geographic
- name: layout
  x: x
  y: y
  provenance: derived
  derived_by: louvain+phyllotaxis
version: gar/v1
