source: crates/fossil-codegen/tests/codegen_calls.rs
expression: sql_for(1)
---
CREATE VIEW users AS
SELECT * FROM read_csv_auto('examples/users.csv', sample_size=-1);
COPY (
    SELECT
        users.id AS subject,
        'https://example.org/value' AS predicate,
        lower(users.raw) AS object
    FROM users
) TO 'output.parquet' (FORMAT PARQUET);
