---
source: crates/fossil-codegen/tests/codegen_ops.rs
assertion_line: 281
expression: sql_for(6)
---
CREATE VIEW a AS
SELECT * FROM read_csv_auto('examples/a.csv', sample_size=-1);
CREATE VIEW b AS
SELECT * FROM read_csv_auto('examples/b.csv', sample_size=-1);
COPY (
    SELECT
        step_2.iri AS subject,
        'https://example.org/name' AS predicate,
        step_2.name AS object
    FROM (SELECT * FROM a UNION SELECT * FROM b) AS step_2
) TO 'output.parquet' (FORMAT PARQUET);
