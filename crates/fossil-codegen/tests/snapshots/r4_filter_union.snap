COPY (
    SELECT
        step_2.iri AS subject,
        'https://example.org/name' AS predicate,
        step_3.name AS object
    FROM (SELECT * FROM source UNION SELECT * FROM source) AS step_2
) TO 'output.parquet' (FORMAT PARQUET);
