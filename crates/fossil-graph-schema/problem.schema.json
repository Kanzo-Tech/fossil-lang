{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Problem",
  "description": "**One failure fossil can report**, identified by its code.\n\nSerialized as `{ \"code\": \"area/kind\", \"data\": { … } }`: the code is the serde tag, and `data` is always an object. `Display` is the message for a person, rendered from the data; nothing should parse it — a value a host needs is a field.",
  "oneOf": [
    {
      "title": "The run needs more memory than its budget",
      "description": "An operator asked for more memory than the run's budget had left. Raised while the graph executes, before any byte of the corpus is written. Sizes are bytes.",
      "type": "object",
      "required": [
        "code",
        "data"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "run/over-budget"
          ]
        },
        "data": {
          "type": "object",
          "required": [
            "budget",
            "consumer",
            "requested",
            "reserved"
          ],
          "properties": {
            "budget": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "consumer": {
              "type": "string"
            },
            "requested": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "reserved": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          }
        }
      }
    },
    {
      "title": "The program does not compile",
      "description": "A run over a program that does not compile. The failure's `related` carries the program's diagnostics.",
      "type": "object",
      "required": [
        "code",
        "data"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "run/does-not-compile"
          ]
        },
        "data": {
          "type": "object"
        }
      }
    },
    {
      "title": "No store covers the destination",
      "description": "The destination a run writes under is not a prefix any store covers.",
      "type": "object",
      "required": [
        "code",
        "data"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "run/destination-uncovered"
          ]
        },
        "data": {
          "type": "object",
          "required": [
            "destination"
          ],
          "properties": {
            "destination": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "title": "More than one output shape",
