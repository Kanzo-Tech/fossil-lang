{
  "name": "@fossil-lang/storage",
  "version": "0.0.0-development",
  "description": "Storage access for every @fossil-lang/* package, from credentials the host vends: a scoped DuckDB secret renewed before it expires, an Azure SAS lend, or an object_store request — fossil-storage in WASM.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanzo-tech/fossil.git",
    "directory": "packages/storage"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pkg/fossil_storage_wasm_bg.wasm": "./pkg/fossil_storage_wasm_bg.wasm"
  },
  "files": [
    "dist/",
    "pkg/fossil_storage_wasm.js",
    "pkg/fossil_storage_wasm.d.ts",
    "pkg/fossil_storage_wasm_bg.wasm",
    "pkg/fossil_storage_wasm_bg.wasm.d.ts",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "pnpm run build:wasm && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "sideEffects": false,
  "dependencies": {
    "@fossil-lang/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
