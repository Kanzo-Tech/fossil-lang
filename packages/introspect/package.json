{
  "name": "@fossil-lang/introspect",
  "version": "0.0.0-development",
  "description": "Source schema introspection for the Fossil editor: reads the sources fossil reports through the host's DuckDB under the credentials the host vends, DESCRIBEs them, and builds the InferredDescriptors the checker consumes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanzo-Tech/fossil-lang.git",
    "directory": "packages/introspect"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "sideEffects": false,
  "dependencies": {
    "@fossil-lang/storage": "workspace:*",
    "@fossil-lang/types": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.8.9",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
