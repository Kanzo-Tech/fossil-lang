{
  "name": "@fossil-lang/wasm",
  "version": "0.0.0-development",
  "description": "The fossil compiler front end in the browser, over the fossil-wasm wasm-bindgen artifacts (--target web): openProgram for an editor, inputs for what a program reads, formats and formatFor.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanzo-Tech/fossil-lang.git",
    "directory": "packages/wasm"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pkg/fossil_wasm_bg.wasm": "./pkg/fossil_wasm_bg.wasm"
  },
  "files": [
    "dist/",
    "pkg/fossil_wasm.js",
    "pkg/fossil_wasm.d.ts",
    "pkg/fossil_wasm_bg.wasm",
    "pkg/fossil_wasm_bg.wasm.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "pnpm run build:wasm && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "sideEffects": false,
  "dependencies": {
    "@fossil-lang/storage": "workspace:*",
    "@fossil-lang/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
