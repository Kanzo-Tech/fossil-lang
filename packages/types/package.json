{
  "name": "@fossil-lang/types",
  "version": "0.0.0-development",
  "description": "The host contract every @fossil-lang package reads sources through, and the shared editor types.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanzo-tech/fossil.git",
    "directory": "packages/types"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.6.0",
    "happy-dom": "^15.0.0",
    "vitest": "^2.0.0"
  }
}
