{
  "name": "@fossil-lang/types",
  "version": "0.0.0-development",
  "description": "The host contract every @fossil-lang package touches storage through — Host, StorageCredential, Access, Scope — the Engine, the shared editor types, and FossilError: the one error every package throws, with the generated catalogue of codes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanzo-Tech/fossil-lang.git",
    "directory": "packages/types"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
