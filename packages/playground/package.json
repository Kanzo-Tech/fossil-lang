{
  "name": "@fossil-lang/playground",
  "version": "0.1.0",
  "description": "Embeddable React playground for Fossil — CodeMirror editor + LSP via WASM Worker + DuckDB-WASM runner + Mosaic/Cosmos.gl result viz. Per ADRs 0024 + 0026 + 0027 + 0028 + 0029 + 0030 + 0032.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanzo-tech/fossil.git",
    "directory": "packages/playground"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "sideEffects": false,
  "dependencies": {
    "@fossil-lang/types": "workspace:*",
    "@fossil-lang/resolvers": "workspace:*",
    "@fossil-lang/examples": "workspace:*",
    "@codemirror/lsp-client": "^6.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "@fossil-lang/wasm": "workspace:*",
    "@fossil-lang/codemirror-fossil": "workspace:*",
    "@duckdb/duckdb-wasm": "1.32.0"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/lint": "^6.8.0",
    "@lezer/highlight": "^1.2.0",
    "@fossil-lang/wasm": "workspace:*",
    "@fossil-lang/codemirror-fossil": "workspace:*",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@testing-library/react": "^16.0.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
