// PLAY-05 example — Fossil-specific typing showcase (CORE-07).
//
// Demonstrates the `|>` pipeline + implicit closure synthesis: the lambda
// `.age >= 18` inside `filter(...)` is implicitly closed over the row binding
// (no `\row -> ...` surface syntax in v0.1 per type-system.md §7). The
// `Adult` mapping consumes the filtered source as if it were a brand-new
// binding — typed `Record<{ id, name, age }>` end-to-end.

prefix ex: <https://example.org/typing/>

users := io.csv("@examples/typing-showcase.csv")

Adult : ex:Adult from users |> filter(.age >= 18)
    iri = `${ex:}adult/${.id}`
    ex:name = .name
    ex:age  = .age
