// PLAY-05 example — hello variant WITHOUT a CSVW descriptor.
//
// Mirrors hello.fossil byte-for-byte except for the source URI: this points
// at `@examples/hello-no-csvw.csv`. By NOT shipping a sibling `.csvw.json`
// descriptor we exercise the PLAY-11 automatic CSVW inference path in the
// playground (DuckDB `read_csv_auto` infers column types from the header).
//
// Use this example to verify: when descriptor panel is empty, inference
// populates a minimal CSVW within ~1s; the editor / runtime then behave as
// if the inferred descriptor were authored by the user.

prefix ex: <https://example.org/>

people := io.csv("@examples/hello-no-csvw.csv")

User : ex:Person from people
    iri = `${ex:}user/${.id}`
    ex:name = .name
