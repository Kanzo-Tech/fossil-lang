// PLAY-05 variation: 03-type-error — empty property RHS.
// MUST fail under `fossil check` with a type-checking diagnostic
// ("type-checking failed: N error(s)").

prefix ex: <https://example.org/>

users := io.csv("@examples/hello.csv")

User : ex:Person from users
    iri = `${ex:}user/${.id}`
    ex:name =
