// PLAY-05 variation: 06-add-prefix — adds a no-op `xsd:` prefix declaration.
// MUST succeed (added prefix is unused but well-formed).

prefix ex:  <https://example.org/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>

users := io.csv("@examples/hello.csv")

User : ex:Person from users
    iri = `${ex:}user/${.id}`
    ex:name = .name
