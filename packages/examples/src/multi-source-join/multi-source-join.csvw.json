{
  "@context": "http://www.w3.org/ns/csvw",
  "tables": [
    {
      "url": "@examples/msj-customers.csv",
      "tableSchema": {
        "columns": [
          { "name": "customer_id", "datatype": "integer", "required": true },
          { "name": "name",        "datatype": "string",  "required": true }
        ]
      }
    },
    {
      "url": "@examples/msj-orders.csv",
      "tableSchema": {
        "columns": [
          { "name": "order_id",    "datatype": "integer", "required": true },
          { "name": "customer_id", "datatype": "integer", "required": true },
          { "name": "amount",      "datatype": "decimal", "required": true }
        ]
      }
    }
  ]
}
